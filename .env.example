# --- Database ---
DATABASE_URL=postgresql+psycopg2://ldip:ldip@localhost:5432/ldip
DATABASE_URL_TEST=postgresql+psycopg2://ldip:ldip@localhost:5432/ldip_test

# --- LLM providers (set the one(s) you have access to) ---
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_ANTHROPIC=claude-sonnet-5
LLM_MODEL_OPENAI=gpt-4o

# --- Confidence / routing thresholds ---
CONFIDENCE_AUTO_APPROVE_THRESHOLD=0.85

# --- Storage ---
STORAGE_BACKEND=local           # local | azure_blob
LOCAL_STORAGE_DIR=./storage/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ldip-documents

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
